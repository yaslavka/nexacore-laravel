APP_NAME=NexaCore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8090

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
